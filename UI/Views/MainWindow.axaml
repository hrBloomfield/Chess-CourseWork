<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.ViewModels"
        x:Class="UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="600" Height="600"
        Icon="/Assets/icon.ico"
        Title="Chess"
        Background="Black">

    <Viewbox Stretch="Uniform">
        <Grid Width="600" Height="600">

            <!-- Board background (this already worked for you) -->
            <Image Source="avares://UI/Assets/SoftWoodBoard.png"
                   Stretch="UniformToFill"/>

            <!-- Named canvas where images will be added programmatically -->
            <Canvas x:Name="PiecesCanvas"
                    Width="600"
                    Height="600"
                    IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</Window>